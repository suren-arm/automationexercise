<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    Executed by Maven Surefire via the <suiteXmlFiles> entry in pom.xml.

    The four required scenarios run in parallel by class. Each test class gets
    its own WebDriver from DriverFactory's ThreadLocal and registers its own
    uniquely generated account, so parallel execution is safe.

    No thread-count is declared here on purpose: SuiteListener applies
    thread.count from config.properties before the suite runs, so that file
    stays the single place run behaviour is configured.
-->
<suite name="Automation Exercise Required Test Cases"
       parallel="classes">

    <listeners>
        <!-- Suite banner and final summary. -->
        <listener class-name="listeners.SuiteListener"/>
        <!-- Per-test logging and the single failure-screenshot hook. -->
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Required UI Tests">
        <classes>
            <class name="tests.TestCase1RegisterUserTest"/>
            <class name="tests.TestCase9SearchProductTest"/>
            <class name="tests.TestCase16PlaceOrderLoginBeforeCheckoutTest"/>
            <class name="tests.TestCase25ScrollUpTest"/>
        </classes>
    </test>
</suite>
