<?xml version="1.0" encoding="UTF-8"?>
<!-- Executed by Maven Surefire via pom.xml <suiteXmlFiles>. -->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    Exactly four requested test classes:
    Test Case 1, Test Case 9, Test Case 16 and Test Case 25.
-->
<suite name="Automation Exercise Required Test Cases"
       parallel="classes">

    <!-- Failure listener for logging and Allure screenshots. -->
    <listeners>
        <listener class-name="listeners.MavenConsoleTestListener"/>
        <listener class-name="listeners.TestNgSuiteListener"/>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Required UI Tests">
        <classes>
            <class name="tests.TestCase1RegisterUserTest"/>
            <class name="tests.TestCase9SearchProductTest"/>
            <class name="tests.TestCase16PlaceOrderLoginBeforeCheckoutTest"/>
            <class name="tests.TestCase25ScrollUpTest"/>
        </classes>
    </test>
</suite>
