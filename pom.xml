<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maven configuration for the Automation Exercise UI framework.
    The project contains only the four requested automated test cases:
    1, 9, 16 and 25.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.suren.qa</groupId>
    <artifactId>automationexercise</artifactId>
    <version>1.0.0</version>
    <name>automationexercise</name>

    <properties>
        <!-- Java 17 is an LTS version suitable for the framework. -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions are centralized for easy maintenance. -->
        <selenium.version>4.35.0</selenium.version>
        <testng.version>7.11.0</testng.version>
        <allure.version>2.29.1</allure.version>
        <log4j.version>2.25.1</log4j.version>

        <!--
            Deliberately empty. These are forwarded to the test JVM below so that
            -Dbrowser=firefox / -Dheadless=true / -DLOG_LEVEL=DEBUG work on the
            command line. Giving them values here instead would mean the build
            always passed a system property, which takes precedence in
            ConfigReader and would make config.properties impossible to change
            in any meaningful way. Blank values are ignored, so the file stays
            the source of the defaults.
        -->
        <browser/>
        <headless/>
        <LOG_LEVEL/>
        <explicit.wait.seconds/>
        <base.url/>
        <thread.count/>
    </properties>

    <dependencies>
        <!-- Selenium WebDriver and PageFactory APIs. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!--
            TestNG is declared once, at compile scope, because the reusable
            listeners in src/main/java implement TestNG interfaces and therefore
            need the API on the main compile classpath - not only at test time.
        -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- Allure integration for TestNG. -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- Log4j2 API and implementation. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiles project source code. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>

            <!-- Executes the four TestNG tests through testng.xml. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>

                <configuration>

                    <!-- Execute the existing TestNG suite definition. -->
                    <suiteXmlFiles>
                        <suiteXmlFile>testng.xml</suiteXmlFile>
                    </suiteXmlFiles>

                    <!-- Keep TestNG/test output visible in Maven console. -->
                    <useFile>false</useFile>
                    <redirectTestOutputToFile>false</redirectTestOutputToFile>
                    <printSummary>true</printSummary>

                    <!-- Keep complete stack traces when tests fail. -->
                    <trimStackTrace>false</trimStackTrace>

                    <!--
                        Forward command-line overrides into the forked test JVM.
                        Blank unless supplied with -D, in which case
                        config.properties provides the value.
                    -->
                    <systemPropertyVariables>
                        <browser>${browser}</browser>
                        <headless>${headless}</headless>
                        <LOG_LEVEL>${LOG_LEVEL}</LOG_LEVEL>
                        <explicit.wait.seconds>${explicit.wait.seconds}</explicit.wait.seconds>
                        <base.url>${base.url}</base.url>
                        <thread.count>${thread.count}</thread.count>
                    </systemPropertyVariables>

                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
